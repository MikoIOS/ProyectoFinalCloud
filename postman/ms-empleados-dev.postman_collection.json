              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.expect(pm.response.code).to.eql(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"trae total, por_estado y por_area\", () => { pm.expect(b.total).to.be.a(\"number\"); pm.expect(b.por_estado).to.have.keys(\"ACTIVO\",\"VACACIONES\",\"CESADO\"); pm.expect(b.por_area).to.be.an(\"object\"); });"
                ]
