{
  "info": {
    "name": "ms-empleados · HCM API (dev)",
    "description": "Ejecutar con Collection Runner EN ORDEN. Requiere ms-usuarios y ms-empleados desplegados y los dos seeds cargados. Cambia base_usuarios y base_empleados por las URLs de cada API (https://<id>.execute-api.us-east-1.amazonaws.com/dev). La carpeta 'Flujo' espera 6 s entre pasos para que los eventos lleguen por SNS -> SQS.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_usuarios",
      "value": "https://ckuqmvszfj.execute-api.us-east-1.amazonaws.com/dev"
    },
    {
      "key": "base_empleados",
      "value": "https://39vy8bpqn4.execute-api.us-east-1.amazonaws.com/dev"
    }
  ],
  "item": [
    {
      "name": "00 Setup (logins en ms-usuarios)",
      "item": [
        {
          "name": "Login andina admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_usuarios}}/auth/login",
              "host": [
                "{{base_usuarios}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"andina\",\n  \"email\": \"admin@andina.pe\",\n  \"password\": \"Demo1234!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.expect(pm.response.code).to.eql(200));",
                  "pm.collectionVariables.set(\"token_andina\", pm.response.json().token);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = () => String(Math.floor(30000000 + Math.random() * 60000000));",
                  "pm.collectionVariables.set(\"doc_aislamiento\", r());",
                  "pm.collectionVariables.set(\"doc_flujo\", r());",
                  "pm.collectionVariables.set(\"email_aislamiento\", \"aisl\" + Date.now() + \"@test.pe\");",
                  "pm.collectionVariables.set(\"email_flujo\", \"flujo\" + Date.now() + \"@test.pe\");"
                ]
              }
            }
          ]
        },
