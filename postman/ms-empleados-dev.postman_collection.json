    {
      "name": "Flujo integrado con ms-usuarios (eventos)",
      "item": [
        {
          "name": "Flujo 1. Crear empleado en andina (publica EmpleadoCreado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_andina}}"
              }
            ],
            "url": {
              "raw": "{{base_empleados}}/empleados",
              "host": [
                "{{base_empleados}}"
              ],
              "path": [
                "empleados"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Prueba\",\n  \"apellidos\": \"Aislamiento\",\n  \"documento\": \"{{doc_flujo}}\",\n  \"email\": \"{{email_flujo}}\",\n  \"area\": \"Tecnología\",\n  \"cargo\": \"Analista de Datos\",\n  \"fecha_ingreso\": \"2026-11-03\",\n  \"salario_base\": 4200.5,\n  \"jefe_id\": \"emp-000001\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.expect(pm.response.code).to.eql(201));",
                  "pm.test(\"sin aviso de evento fallido\", () => pm.expect(pm.response.json()).to.not.have.property(\"aviso\"));",
                  "pm.collectionVariables.set(\"id_flujo\", pm.response.json().empleado_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Flujo 2. ms-usuarios creó el usuario: login con email y documento como clave => 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_usuarios}}/auth/login",
              "host": [
                "{{base_usuarios}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"andina\",\n  \"email\": \"{{email_flujo}}\",\n  \"password\": \"{{doc_flujo}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.expect(pm.response.code).to.eql(200));",
                  "pm.test(\"debe cambiar la contraseña\", () => pm.expect(pm.response.json().usuario.debe_cambiar_password).to.be.true);",
                  "pm.test(\"rol empleado y vinculado\", () => { const u = pm.response.json().usuario; pm.expect(u.rol).to.eql(\"empleado\"); pm.expect(u.empleado_id).to.eql(pm.collectionVariables.get(\"id_flujo\")); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(function () {}, 6000);  // da tiempo a SNS -> SQS -> Lambda"
                ]
              }
            }
          ]
        },
        {
          "name": "Flujo 3. Cesar al empleado (publica EmpleadoCesado)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_andina}}"
              }
            ],
            "url": {
              "raw": "{{base_empleados}}/empleados/{{id_flujo}}/estado",
              "host": [
                "{{base_empleados}}"
              ],
              "path": [
                "empleados",
                "{{id_flujo}}",
                "estado"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"CESADO\",\n  \"fecha_cese\": \"2026-11-30\",\n  \"motivo\": \"Prueba de flujo\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.expect(pm.response.code).to.eql(200));",
                  "pm.test(\"CESADO\", () => pm.expect(pm.response.json().estado).to.eql(\"CESADO\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Flujo 4. ms-usuarios desactivó la cuenta: login => 403",
