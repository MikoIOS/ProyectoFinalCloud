  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://ckuqmvszfj.execute-api.us-east-1.amazonaws.com/dev"
    },
    {
      "key": "token_andina",
      "value": ""
    },
    {
      "key": "token_pacifico",
      "value": ""
    },
    {
      "key": "user_id_nuevo",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Setup (logins)",
      "item": [
        {
          "name": "Login andina admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"andina\",\n  \"email\": \"admin@andina.pe\",\n  \"password\": \"Demo1234!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 y token\", () => { pm.expect(pm.response.code).to.eql(200); pm.expect(pm.response.json().token).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"token_andina\", pm.response.json().token);",
                  "pm.test(\"el token es del tenant correcto\", () => pm.expect(pm.response.json().usuario.tenant_id).to.eql(\"andina\"));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"email_prueba\", \"prueba\" + Date.now() + \"@test.pe\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Login pacifico admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
